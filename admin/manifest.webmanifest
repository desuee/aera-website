{
  "name": "AERA Admin",
  "short_name": "AERA Admin",
  "description": "Postfach, Kalender, Beta-Tester und AERA-Studio von aerastudios.de",
  "id": "/admin/",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#07111F",
  "theme_color": "#07111F",
  "lang": "de",
  "icons": [
    {
      "src": "/img/brand-app-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/img/brand-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Posteingang",
      "url": "/admin/#mail",
      "icons": [
        {
          "src": "/img/brand-app-512.png",
          "sizes": "512x512"
        }
      ]
    },
    {
      "name": "Kalender",
      "url": "/admin/#cal",
      "icons": [
        {
          "src": "/img/brand-app-512.png",
          "sizes": "512x512"
        }
      ]
    },
    {
      "name": "Neue E-Mail",
      "url": "/admin/#compose",
      "icons": [
        {
          "src": "/img/brand-app-512.png",
          "sizes": "512x512"
        }
      ]
    }
  ]
}